rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validVisibility() {
      return request.resource.data.visibility in ['private', 'public'];
    }

    function isPublic() {
      return ('visibility' in resource.data)
        && resource.data.visibility == 'public';
    }

    function validImageDocument() {
      return request.resource.data.keys().hasAll([
          'data',
          'contentType',
          'imageName',
          'width',
          'height',
          'size',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'data',
          'contentType',
          'imageName',
          'width',
          'height',
          'size',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.contentType == 'image/webp'
        && request.resource.data.data is bytes
        && request.resource.data.data.size() <= 112640
        && request.resource.data.imageName is string
        && request.resource.data.width is int
        && request.resource.data.width > 0
        && request.resource.data.width <= 512
        && request.resource.data.height is int
        && request.resource.data.height > 0
        && request.resource.data.height <= 512
        && request.resource.data.size is int
        && request.resource.data.size >= 0
        && request.resource.data.size <= 112640
        && request.resource.data.size == request.resource.data.data.size()
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function parentSetIsPublic(userId, setId) {
      return get(/databases/$(database)/documents/users/$(userId)/wheelSets/$(setId)).data.visibility == 'public';
    }

    match /users/{userId}/wheelSets/{setId} {
      allow get, list: if (signedIn() && request.auth.uid == userId)
        || isPublic();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.ownerId == request.auth.uid
        && validVisibility();

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.ownerId == request.auth.uid
        && validVisibility()
        && (
          (!('ownerId' in resource.data))
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId'])
        );

      allow delete: if signedIn() && request.auth.uid == userId;

      match /images/{imageId} {
        allow get, list: if (signedIn() && request.auth.uid == userId)
          || parentSetIsPublic(userId, setId);

        allow create, update: if signedIn()
          && request.auth.uid == userId
          && validImageDocument();

        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    // Разрешает collectionGroup-запрос только для явно опубликованных наборов.
    // Документы без visibility не проходят это условие и остаются личными.
    match /{path=**}/wheelSets/{setId} {
      allow get, list: if isPublic();
    }
  }
}
